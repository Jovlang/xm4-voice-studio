    "test:fota-machine": "tsx test/fota-machine.ts",
    "test:commit-diagnostics": "tsx test/commit-diagnostics.ts",
    "test:sound-import": "node test/sound-import.mjs",
    "test:pack-import": "node test/pack-import.mjs",
    "test:audio": "tsx test/audio.ts",
    "test:store": "node test/store.mjs",
    "test:transport": "tsx test/transport.ts",
    "astro": "astro",
    "og": "chromium --headless --disable-gpu --hide-scrollbars --allow-file-access-from-files --window-size=1200,630 --virtual-time-budget=2000 --screenshot=public/og-image.png \"file://$PWD/scripts/og-card.html\""
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
