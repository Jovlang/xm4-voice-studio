# Sharing packs (optional). Without these the Share button is hidden.
# Supabase project URL and its anon/publishable key (Project Settings → API). Both are public.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Public Storage bucket the zips go in.
PUBLIC_SUPABASE_BUCKET=packs
